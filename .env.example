# CMO Beat — environment variables. Copy to .env and fill in. Never commit real values.

# ── Database (Supabase Postgres in production; local Postgres 16 + pgvector in dev) ──
# Owner connection: migrations, seed, background jobs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cmobeat
# Restricted app role (no BYPASSRLS). Every user request runs through this with RLS on.
APP_DATABASE_URL=postgres://cmobeat_app:cmobeat_app@localhost:5432/cmobeat
# Integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cmobeat_test
TEST_APP_DATABASE_URL=postgres://cmobeat_app:cmobeat_app@localhost:5432/cmobeat_test

# ── Auth ──
# clerk in production. dev = local sign-in as a sample user; refused when NODE_ENV=production.
AUTH_MODE=dev
# 32+ random characters. Generate: openssl rand -base64 48
DEV_AUTH_SECRET=
# Set to true only for local/CI production builds that run end-to-end tests.
# Dev sign-in is always refused when VERCEL_ENV=production.
ALLOW_DEV_AUTH_IN_PRODUCTION=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Encryption ──
# Field-level encryption master key (envelope encryption). 32 bytes, base64.
# Generate: openssl rand -base64 32. In production this moves to a managed KMS (Supabase Vault).
ENCRYPTION_MASTER_KEY=

# ── Site ──
# Public origin. Used for canonical URLs, sitemaps, emails and checkout redirects.
SITE_URL=http://localhost:3000
# Absolute origin for links in emails and payment redirects. Wins over the request Host header.
APP_URL=http://localhost:3000
# Optional shared secret for calling cron endpoints (e.g. POST /api/listings/expire) without Inngest.
CRON_SECRET=

# ── AI agents ──
# anthropic | fake. Defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise fake (offline fixtures).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# 1 = evals call the live API, record outputs and print cost. Needs ANTHROPIC_API_KEY.
EVALS_LIVE=
# Moves Tracker sources, comma-separated "Publisher|https://feed-url". Empty = disabled.
MOVES_NEWSROOM_FEEDS=
MOVES_WIRE_FEEDS=
# SEC EDGAR requires a descriptive User-Agent with contact details, e.g. "CMO Beat ops@yourdomain".
# EDGAR is disabled until this is set. Never commit a personal email here.
SEC_USER_AGENT=
# fixtures = use bundled demo sources locally instead of the network.
MOVES_SOURCES=

# ── Email ──
# outbox (default: record only, nothing leaves the machine) | resend
EMAIL_PROVIDER=outbox
RESEND_API_KEY=
EMAIL_FROM="CMO Beat <hello@cmobeat.com>"
RESEND_NEWSLETTER_SEGMENT_ID=
# Physical postal address shown in every email footer (CAN-SPAM, CASL). Required before sending.
COMPANY_POSTAL_ADDRESS=
# Salt for hashing IPs in the signup rate limiter (in memory only).
RATE_LIMIT_SALT=

# ── Interviews and storage ──
# Delay between streamed words in offline interviews, in ms (default 35; 0 in tests).
INTERVIEW_STREAM_DELAY_MS=
# local (default: encrypted bytes in Postgres) | supabase
STORAGE_PROVIDER=local
# 32+ characters, signs short-lived download links. Falls back to DEV_AUTH_SECRET in dev.
STORAGE_URL_SECRET=
# For STORAGE_PROVIDER=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=
# Where the staff console reads offline eval results (default agents/eval-report.json).
EVAL_REPORT_PATH=

# ── Payments ──
# fake (default without Stripe keys; refused when VERCEL_ENV=production) | stripe
PAYMENTS_PROVIDER=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_JOB_POST_STANDARD=
STRIPE_PRICE_JOB_POST_FEATURED=
# Optional; defaults to a value derived from DEV_AUTH_SECRET.
FAKE_PAYMENTS_SECRET=

# ── Later phases ──
# VOYAGE_API_KEY=               Phase 3, embeddings
# STRIPE_PRICE_EMPLOYER_SUBSCRIPTION=
# STRIPE_PRICE_CANDIDATE_CONCIERGE=
# INNGEST_EVENT_KEY=            background jobs in production
# INNGEST_SIGNING_KEY=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
