# CMO Beat — environment variables. Copy to .env and fill in. Never commit real values.

# ── Database (Supabase Postgres in production; local Postgres 16 + pgvector in dev) ──
# Owner connection: migrations, seed, background jobs.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cmobeat
# Restricted app role (no BYPASSRLS). Every user request runs through this with RLS on.
APP_DATABASE_URL=postgres://cmobeat_app:cmobeat_app@localhost:5432/cmobeat
# Integration tests.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/cmobeat_test
TEST_APP_DATABASE_URL=postgres://cmobeat_app:cmobeat_app@localhost:5432/cmobeat_test

# ── Auth ──
# clerk in production. dev = local sign-in as a sample user; refused when NODE_ENV=production.
AUTH_MODE=dev
# 32+ random characters. Generate: openssl rand -base64 48
DEV_AUTH_SECRET=
# Set to true only for local/CI production builds that run end-to-end tests.
# Dev sign-in is always refused when VERCEL_ENV=production.
ALLOW_DEV_AUTH_IN_PRODUCTION=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Encryption ──
# Field-level encryption master key (envelope encryption). 32 bytes, base64.
# Generate: openssl rand -base64 32. In production this moves to a managed KMS (Supabase Vault).
ENCRYPTION_MASTER_KEY=

# ── Later phases (documented now so nothing is hard-coded) ──
# ANTHROPIC_API_KEY=            Phase 1, agents
# VOYAGE_API_KEY=               Phase 3, embeddings
# STRIPE_SECRET_KEY=            Phase 1, checkout
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_JOB_POST_STANDARD=
# STRIPE_PRICE_JOB_POST_FEATURED=
# STRIPE_PRICE_EMPLOYER_SUBSCRIPTION=
# STRIPE_PRICE_CANDIDATE_CONCIERGE=
# RESEND_API_KEY=               Phase 1, email + newsletter
# INNGEST_EVENT_KEY=            Phase 1, background jobs
# INNGEST_SIGNING_KEY=
# SUPABASE_URL=                 storage
# SUPABASE_SERVICE_ROLE_KEY=
# SENTRY_DSN=
# NEXT_PUBLIC_POSTHOG_KEY=
