{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AI_PROVIDER",
    "ALLOW_DEV_AUTH_IN_PRODUCTION",
    "ANTHROPIC_API_KEY",
    "APP_DATABASE_URL",
    "APP_URL",
    "AUTH_MODE",
    "CLERK_SECRET_KEY",
    "COMPANY_POSTAL_ADDRESS",
    "CRON_SECRET",
    "DATABASE_URL",
    "DEV_AUTH_SECRET",
    "EMAIL_FROM",
    "EMAIL_PROVIDER",
    "EMBEDDINGS_PROVIDER",
    "ENCRYPTION_MASTER_KEY",
    "EVALS_LIVE",
    "EVAL_REPORT_PATH",
    "FAIRNESS_LIVE",
    "FAKE_PAYMENTS_SECRET",
    "INNGEST_DEV",
    "INNGEST_EVENT_KEY",
    "INTERVIEW_STREAM_DELAY_MS",
    "MATCHER_BATCH",
    "MOVES_NEWSROOM_FEEDS",
    "MOVES_SOURCES",
    "MOVES_WIRE_FEEDS",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NODE_ENV",
    "PAYMENTS_PROVIDER",
    "RATE_LIMIT_SALT",
    "RESEND_API_KEY",
    "RESEND_NEWSLETTER_SEGMENT_ID",
    "SEC_USER_AGENT",
    "SITE_URL",
    "STORAGE_BUCKET",
    "STORAGE_PROVIDER",
    "STORAGE_URL_SECRET",
    "STRIPE_PRICE_JOB_POST_FEATURED",
    "STRIPE_PRICE_JOB_POST_STANDARD",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "SUPABASE_SERVICE_ROLE_KEY",
    "SUPABASE_URL",
    "TEST_APP_DATABASE_URL",
    "TEST_DATABASE_URL",
    "VERCEL_ENV",
    "VOYAGE_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "storybook-static/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    }
  }
}
